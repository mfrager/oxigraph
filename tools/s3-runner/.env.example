# Settings of the S3 compatible object store that holds a SlateDB database.
#
# Copy this file to `.env`, fill in the values, then run for example:
#
#     oxigraph-s3 serve --bind 0.0.0.0:7878
#
# Each value may also be given in the environment: the `.env` file only fills in
# the variables that are not already set.
#
# The runner turns these settings into the `AWS_*` variables that the S3 client
# of SlateDB reads (`AWS_ENDPOINT`, `AWS_ACCESS_KEY_ID`, `AWS_SECRET_ACCESS_KEY`,
# `AWS_REGION`, `AWS_ALLOW_HTTP`, ...) and opens the database at
# `s3://<bucket>/<base path>` with `oxigraph --object-store`.

# Host of the endpoint, without scheme and without port: an IP address, a DNS
# name, or `s3.amazonaws.com` for AWS S3.
S3_HOST=127.0.0.1

# Port of the endpoint. Leave it empty to use the default port of the scheme.
S3_PORT=9000

# `http` for RustFS, MinIO and other stores behind plain HTTP on a trusted
# network, `https` for AWS S3 and anything behind TLS.
S3_SCHEME=http

# Bucket that holds the database. It has to exist already, since S3 credentials
# usually may not create buckets. Lowercase letters, digits, `.` and `-` only.
S3_BUCKET=oxigraph

# Path of the database inside the bucket. It is created on the first write, and
# an empty value puts the database at the root of the bucket. Letters, digits,
# `.`, `-`, `_`, `~` and `/` only.
S3_BASE_PATH=slatedb

# Credentials of a user that may read and write the bucket: an access key pair,
# or a temporary pair together with S3_SESSION_TOKEN.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# S3_SESSION_TOKEN=

# Region of the bucket. RustFS and MinIO accept any value, AWS S3 needs the
# region the bucket lives in.
S3_REGION=us-east-1

# Path of the oxigraph executable to run, when it is not on the PATH.
# OXIGRAPH_BIN=target/debug/oxigraph
